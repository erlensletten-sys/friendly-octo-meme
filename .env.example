# ---------------------------------------------------------------------------
# Visningsrom - miljøvariabler
# Kopier til .env.local. Alle er valgfrie; appen kjører uten dem lokalt.
# ---------------------------------------------------------------------------

# Passord for admin-delen (galleri, opplasting, sletting, deling).
# Settes den ikke, er admin-delen åpen - greit lokalt, IKKE greit i produksjon.
# Kundelenker (/s/<token>) er alltid åpne uten passord.
ADMIN_PASSWORD=

# Maks filstørrelse per opplasting i MB.
# Uten Vercel Blob går fila gjennom serveren, og på Vercel gjelder da en hard
# grense på ~4,5 MB per request. Med Blob koblet til lastes fila opp direkte fra
# nettleseren, og denne verdien er det eneste taket - den kan trygt økes.
MAX_UPLOAD_MB=25

# Lagring. Uten denne brukes lokalt filsystem (.data/) - fint til dev og til
# egen server/Docker. På Vercel er filsystemet skrivebeskyttet, så der må
# Vercel Blob kobles til (Storage -> Blob), som setter denne automatisk.
BLOB_READ_WRITE_TOKEN=

# Tving en bestemt lagringsdriver: "fs" eller "blob". Auto hvis tom.
STORAGE_DRIVER=

# Katalog for lokal lagring (kun driver "fs").
STORAGE_DIR=.data

# Sett til "false" for å skru av CSP-sandbox på serverte preview-filer.
# Sandbox på gir best sikkerhet, men blokkerer localStorage i malene dine.
PREVIEW_STRICT_SANDBOX=true

# Support-chatten på hjemmesiden svares av en AI-agent. Tre leverandører;
# den første som er satt opp brukes (rekkefølge: cloudflare, openai,
# anthropic), eller sett SUPPORT_PROVIDER for å velge. Uten noen viser
# chatten en beskjed om å sende e-post. ANTHROPIC_API_KEY=mock gir et fast
# testsvar lokalt.

# 1) Cloudflare Workers AI - gratis kvote hver dag (10 000 «neurons» ≈ 140
#    svar med standardmodellen). Konto-ID står i Cloudflare-dashbordet
#    (Workers & Pages → Overview, høyre side). Token: My Profile → API
#    Tokens → Create Token → mal «Workers AI».
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# 2) Et hvilket som helst OpenAI-kompatibelt endepunkt: Ollama på serveren
#    (http://127.0.0.1:11434/v1, ingen nøkkel), Groq, OpenRouter …
SUPPORT_BASE_URL=
SUPPORT_API_KEY=

# 3) Claude via Anthropic (faktureres per token).
ANTHROPIC_API_KEY=

# Modell. Tom = leverandørens standard: @cf/meta/llama-3.3-70b-instruct-fp8-fast
# hos Cloudflare, llama3.1 for OpenAI-kompatible, claude-sonnet-5 hos Anthropic.
SUPPORT_MODEL=
# Tving leverandør: cloudflare | openai | anthropic | mock
SUPPORT_PROVIDER=
