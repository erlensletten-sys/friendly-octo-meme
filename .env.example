# ---------------------------------------------------------------------------
# Visningsrom - miljøvariabler
# Kopier til .env.local. Alle er valgfrie; appen kjører uten dem lokalt.
# ---------------------------------------------------------------------------

# Passord for admin-delen (galleri, opplasting, sletting, deling).
# Settes den ikke, er admin-delen åpen - greit lokalt, IKKE greit i produksjon.
# Kundelenker (/s/<token>) er alltid åpne uten passord.
ADMIN_PASSWORD=

# Maks filstørrelse per opplasting i MB.
# Uten Vercel Blob går fila gjennom serveren, og på Vercel gjelder da en hard
# grense på ~4,5 MB per request. Med Blob koblet til lastes fila opp direkte fra
# nettleseren, og denne verdien er det eneste taket - den kan trygt økes.
MAX_UPLOAD_MB=25

# Lagring. Uten denne brukes lokalt filsystem (.data/) - fint til dev og til
# egen server/Docker. På Vercel er filsystemet skrivebeskyttet, så der må
# Vercel Blob kobles til (Storage -> Blob), som setter denne automatisk.
BLOB_READ_WRITE_TOKEN=

# Tving en bestemt lagringsdriver: "fs" eller "blob". Auto hvis tom.
STORAGE_DRIVER=

# Katalog for lokal lagring (kun driver "fs").
STORAGE_DIR=.data

# Sett til "false" for å skru av CSP-sandbox på serverte preview-filer.
# Sandbox på gir best sikkerhet, men blokkerer localStorage i malene dine.
PREVIEW_STRICT_SANDBOX=true

# Support-chatten på hjemmesiden svares av en AI-agent (Anthropic). Uten
# nøkkel viser chatten en beskjed om å sende e-post i stedet. Sett til "mock"
# lokalt for å teste uten nøkkel - da svarer den med en fast tekst.
ANTHROPIC_API_KEY=

# Modellen chatten bruker. Standard er en rask og rimelig modell.
SUPPORT_MODEL=claude-sonnet-5
